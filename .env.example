# MIOS environment variables.
# Copy to .env and fill in the keys you have. Every missing key degrades
# gracefully: data layers fall back across sources, and the AI committee
# falls back to deterministic synthesis.

# AI providers (LLM committee chain: Groq-first, OpenCode/Laguna-first on
# escalation, Ollama and Gemini as fallbacks)
GROQ_API_KEY=
OPENCODE_API_KEY=
OLLAMA_API_KEY=
GEMINI_API_KEY=

# Market / macro data
TWELVE_DATA_API_KEY=
FRED_API_KEY=

# News
# NEWSAPI_KEY backs the NewsAPI fallback in the news repository chain
# (GDELT -> NewsAPI -> RSS/discovery). FINNHUB_API_KEY backs the Finnhub
# provider and the tier-2 Finnhub connector. The remaining keys are read
# directly by the RSS discovery layer and its optional keyed APIs; every
# missing key only removes that one source, never breaks the chain.
NEWSAPI_KEY=
FINNHUB_API_KEY=
MARKETAUX_API_KEY=
THENEWSAPI_KEY=
WORLDNEWSAPI_KEY=

# Notifications (optional)
DISCORD_WEBHOOK_URL=
