    "ContractStatus": {
      "enum": [
        "SUCCESS",
        "PARTIAL_SUCCESS",
        "STALE_DATA",
        "FAILED",
        "NO_DATA",
        "INVALID_INPUT"
      ],
      "title": "ContractStatus",
      "type": "string"
    },
    "DXYSnapshot": {
      "additionalProperties": false,
      "properties": {
        "change": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Change"
        },
        "price": {
          "anyOf": [
            {
              "exclusiveMinimum": 0.0,
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            }
          ],
          "title": "Price"
        },
        "timestamp": {
          "format": "date-time",
          "title": "Timestamp",
          "type": "string"
        }
      },
      "required": [
        "price",
        "timestamp"
      ],
      "title": "DXYSnapshot",
      "type": "object"
    },
    "DataProviderId": {
      "enum": [
        "twelve_data",
        "fred",
        "newsapi",
        "groq",
        "discord",
        "finnhub",
        "gemini",
        "cftc_cot",
        "spdr_gld",
        "gdelt"
      ],
      "title": "DataProviderId",
      "type": "string"
    },
    "GoldPriceSnapshot": {
      "additionalProperties": false,
