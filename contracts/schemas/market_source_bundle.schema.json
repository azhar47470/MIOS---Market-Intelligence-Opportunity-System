          "type": "string"
        },
        "symbol": {
          "$ref": "#/$defs/MarketSymbol"
        },
        "timeframe": {
          "$ref": "#/$defs/Timeframe"
        },
        "timestamp": {
          "format": "date-time",
          "title": "Timestamp",
          "type": "string"
        },
        "volume": {
          "anyOf": [
            {
              "minimum": 0.0,
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Volume"
        }
      },
      "required": [
        "symbol",
        "provider_symbol",
        "timeframe",
        "timestamp",
        "open",
        "high",
        "low",
        "close",
        "provider"
